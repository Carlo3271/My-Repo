{
  "name": "attack spread example",
  "steps": [
    { "label": "open attack menu", "tap": "home_attack", "wait_after": 1.5 },
    { "label": "find a match", "tap": "find_match", "wait_after": 6.0 },
    { "label": "select first troop", "tap": "troop_slot_1", "wait_after": 0.3 },
    {
      "repeat": 2,
      "steps": [
        { "tap": "deploy_top_left", "wait_after": 0.15 },
        { "tap": "deploy_top_right", "wait_after": 0.15 },
        { "tap": "deploy_bottom_left", "wait_after": 0.15 },
        { "tap": "deploy_bottom_right", "wait_after": 0.15 }
      ]
    },
    { "label": "select second troop", "tap": "troop_slot_2", "wait_after": 0.3 },
    {
      "repeat": 3,
      "steps": [
        { "tap": "deploy_left_mid", "wait_after": 0.12 },
        { "tap": "deploy_right_mid", "wait_after": 0.12 }
      ]
    },
    { "label": "save post-deploy screenshot", "screenshot": "screenshots/post_deploy.png" }
  ]
}
