{
  "name": "Clash E-Drag funnel widescreen",
  "steps": [
    { "label": "open or reuse battle", "ensure_battle": { "timeout": 12.0, "interval": 0.35, "screenshot": "screenshots/battle_ready.png" } },

    { "label": "start hero funnel", "tap": "hero_queen", "wait_after": 0.18 },
    { "tap": "deploy_left_edge_top", "wait_after": 0.16 },
    { "tap": "hero_king", "wait_after": 0.18 },
    { "tap": "deploy_left_edge_bottom", "wait_after": 0.25 },

    { "label": "balloons first", "tap": "troop_balloons", "wait_after": 0.22 },
    {
      "repeat": 3,
      "steps": [
        { "tap": "deploy_left_edge_top", "wait_after": 0.09 },
        { "tap": "deploy_left_edge_bottom", "wait_after": 0.09 },
        { "tap": "deploy_top_edge_left", "wait_after": 0.09 },
        { "tap": "deploy_right_edge_top", "wait_after": 0.09 }
      ]
    },

    { "label": "electro dragons in line", "tap": "troop_edragons", "wait_after": 0.22 },
    {
      "repeat": 2,
      "steps": [
        { "tap": "deploy_left_edge_top", "wait_after": 0.10 },
        { "tap": "deploy_left_edge_bottom", "wait_after": 0.10 },
        { "tap": "deploy_top_edge_left", "wait_after": 0.10 },
        { "tap": "deploy_right_edge_top", "wait_after": 0.10 }
      ]
    },

    { "label": "minions cleanup", "tap": "troop_minions", "wait_after": 0.20 },
    { "tap": "deploy_left_edge_bottom", "wait_after": 0.10 },
    { "tap": "deploy_top_edge_left", "wait_after": 0.10 },
    { "tap": "deploy_right_edge_top", "wait_after": 0.10 },

    { "label": "rage core path", "tap": "spell_rage", "wait_after": 0.18 },
    { "tap": "spell_top_core", "wait_after": 0.12 },
    { "tap": "spell_core", "wait_after": 0.12 },
    { "tap": "spell_bottom_core", "wait_after": 0.12 },

    { "label": "freeze threats", "tap": "spell_freeze", "wait_after": 0.18 },
    { "tap": "spell_top_core", "wait_after": 0.12 },
    { "tap": "spell_core", "wait_after": 0.12 },
    { "tap": "spell_bottom_core", "wait_after": 0.12 },

    { "label": "trigger hero abilities", "wait": 2.0 },
    { "tap": "hero_king", "wait_after": 0.12 },
    { "tap": "hero_queen", "wait_after": 0.12 }
  ]
}
